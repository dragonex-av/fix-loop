# FixLoop Backend Environment Variables
APP_NAME=FixLoop API
DEBUG=True
DATABASE_URL=sqlite:///./fixloop.db

# Hindsight Cloud Memory API
# Obtain from Hindsight dashboard / docs
HINDSIGHT_BASE_URL=https://api.hindsight.cloud
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_OR_AGENT_ID=fixloop-operations

# Groq LLM API
# Obtain from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
