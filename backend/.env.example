# FixLoop Backend Environment Variables
APP_NAME=FixLoop API
DEBUG=True

# Database (defaults to SQLite: sqlite:///./fixloop.db, or NeonDB PostgreSQL)
DATABASE_URL=sqlite:///./fixloop.db

# Auth
JWT_SECRET=fixloop-super-secure-jwt-secret-key-2026-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth Client ID (Set up in Google Cloud Console: Web Application, Authorized JavaScript origins: http://localhost:5173)
GOOGLE_CLIENT_ID=

# Role allowlists (comma-separated lowercase emails)
ADMIN_EMAILS=admin@fixloop.com,sarah.jenkins@fixloop.com
TECHNICIAN_EMAILS=tech.vikram@fixloop.com,tech.rajesh@fixloop.com,deepak.v@fixloop.com,support@fixloop.com

# Hindsight Cloud Memory API
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_OR_AGENT_ID=fixloop-operations

# Groq LLM API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Business Configuration
REPEAT_WINDOW_DAYS=30
RIPPLE_THRESHOLD=3
SMTP_ENABLED=False
